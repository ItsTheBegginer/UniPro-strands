# LLM Provider Configuration
MODEL_PROVIDER=bedrock                 # bedrock | gemini
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0
BEDROCK_REGION=eu-north-1              # Bedrock inference region
AWS_REGION=us-east-1                   # General AWS services region

# AWS Cloud Storage
S3_BUCKET=unipro-aws                   # Amazon S3 bucket for student documents
# STORAGE_BACKEND=file                 # file | dynamodb
# DYNAMODB_TABLE_PROFILES=unipro-profiles
# DYNAMODB_TABLE_APPLICATIONS=unipro-applications

# Optional Gemini Fallback
# GEMINI_API_KEY=your-gemini-key
# GEMINI_MODEL_ID=gemini-3.5-flash-lite

# Portal & Browser Configuration
DEMO_UNIVERSITY_URL=http://localhost:8080
BROWSER_HEADLESS=false                 # true = invisible, false = watch the browser live
BROWSER_SLOW_MO_MS=300                 # slows interactions so live runs are observable
